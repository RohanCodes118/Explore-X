[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/dialogue_overlay.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/images/rix_portrait.png" id="2_portrait"]
[ext_resource type="Texture2D" path="res://assets/images/ancient_sword.png" id="3_sword"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_dialog"]
bg_color = Color(0.02, 0.05, 0.1, 0.94)
border_width_left = 3
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.75, 1, 0.85)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
shadow_color = Color(0.05, 0.35, 0.6, 0.45)
shadow_size = 18

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_portrait_frame"]
bg_color = Color(0.04, 0.08, 0.16, 0.9)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.25, 0.8, 1, 0.8)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_gift"]
bg_color = Color(0.03, 0.07, 0.14, 0.96)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.3, 0.9, 1, 0.9)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
shadow_color = Color(0.1, 0.6, 1, 0.5)
shadow_size = 24

[node name="DialogueOverlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="DialogPanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(1100, 230)
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -550.0
offset_top = -270.0
offset_right = 550.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_dialog")

[node name="Margin" type="MarginContainer" parent="DialogPanel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 20

[node name="HBox" type="HBoxContainer" parent="DialogPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 26

[node name="PortraitFrame" type="PanelContainer" parent="DialogPanel/Margin/HBox"]
custom_minimum_size = Vector2(140, 140)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_portrait_frame")

[node name="Portrait" type="TextureRect" parent="DialogPanel/Margin/HBox/PortraitFrame"]
unique_name_in_owner = true
layout_mode = 2
texture = ExtResource("2_portrait")
expand_mode = 1
stretch_mode = 6

[node name="VBox" type="VBoxContainer" parent="DialogPanel/Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="SpeakerLabel" type="Label" parent="DialogPanel/Margin/HBox/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.85, 1, 1)
theme_override_constants/letter_spacing = 3
theme_override_font_sizes/font_size = 18
text = "MYSTERIOUS STRANGER"

[node name="HSeparator" type="HSeparator" parent="DialogPanel/Margin/HBox/VBox"]
layout_mode = 2

[node name="DialogText" type="Label" parent="DialogPanel/Margin/HBox/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.92, 0.96, 1, 1)
theme_override_constants/letter_spacing = 1
theme_override_font_sizes/font_size = 20
text = "“You survived the fall. Not many ships survive this world's atmosphere.”"
autowrap_mode = 2

[node name="PromptAdvance" type="Label" parent="DialogPanel/Margin/HBox/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.75, 0.9, 0.75)
theme_override_constants/letter_spacing = 1
theme_override_font_sizes/font_size = 13
text = "[E / SPACE / CLICK TO ADVANCE]"
horizontal_alignment = 2

[node name="GiftPopup" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(620, 280)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -310.0
offset_top = -140.0
offset_right = 310.0
offset_bottom = 140.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_gift")

[node name="Margin" type="MarginContainer" parent="GiftPopup"]
layout_mode = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 25
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 25

[node name="VBox" type="VBoxContainer" parent="GiftPopup/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="GiftTitle" type="Label" parent="GiftPopup/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.95, 1, 1)
theme_override_constants/letter_spacing = 3
theme_override_font_sizes/font_size = 20
text = "WEAPON ACQUIRED // ANCIENT PLASMA BLADE"
horizontal_alignment = 1

[node name="IconCenter" type="CenterContainer" parent="GiftPopup/Margin/VBox"]
custom_minimum_size = Vector2(0, 110)
layout_mode = 2

[node name="GiftIcon" type="TextureRect" parent="GiftPopup/Margin/VBox/IconCenter"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 100)
layout_mode = 2
texture = ExtResource("3_sword")
expand_mode = 1
stretch_mode = 6

[node name="GiftDesc" type="Label" parent="GiftPopup/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.95, 1, 0.9)
theme_override_font_sizes/font_size = 15
text = "Gifted by your grandfather. Press [F] or [J] or [LEFT CLICK] to wield."
horizontal_alignment = 1

[node name="GiftClosePrompt" type="Label" parent="GiftPopup/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.8, 0.95, 0.8)
theme_override_constants/letter_spacing = 2
theme_override_font_sizes/font_size = 13
text = "[PRESS E / SPACE TO EQUIP]"
horizontal_alignment = 1
